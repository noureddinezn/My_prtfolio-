{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": false
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?:about|experience|projects(?:/[^/.]+)?|certifications|contact)?/?$",
      "dest": "/index.html",
      "methods": [
        "GET",
        "HEAD"
      ]
    }
  ]
}
